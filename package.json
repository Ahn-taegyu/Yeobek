{
  "name": "yeobek",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "ai:check": "node scripts/ai-check.mjs",
    "ai:bundle": "node scripts/ai-plugin.mjs",
    "ai:bundle:check": "node scripts/ai-plugin.mjs --check",
    "pretest": "npm run ai:bundle:check",
    "prebuild": "npm run ai:bundle:check",
    "preai:eval": "npm run ai:bundle:check",
    "preai:smoke": "npm run ai:bundle:check",
    "ai:eval": "vitest run tests/unit/ai-harness.test.ts tests/unit/ai-providers.test.ts tests/unit/ai-plugin.test.ts",
    "ai:smoke": "node scripts/ai-smoke.mjs",
    "db:start": "node scripts/start-local.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --network-id yeobek-local",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "db:env": "node scripts/local-env.mjs",
    "db:artist": "node scripts/local-artist.mjs",
    "db:types": "node scripts/database-types.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.32",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module"
}
