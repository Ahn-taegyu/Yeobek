# Copy to .env.local. Use a disposable local Supabase project first.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# AI adapters are server-only and not yet wired to public routes.
# Add these to your EXISTING .env.local; never overwrite Supabase settings.
OPENAI_API_KEY=
OPENAI_QA_MODEL=gpt-6-luna
OPENAI_JUDGE_MODEL=gpt-6-luna
OPENAI_STT_MODEL=gpt-transcribe
LINER_API_KEY=
LINER_DRAFT_MODEL=openai/gpt-6.1-sol
AI_TTS_PROVIDER=typecast
TYPECAST_API_KEY=
TYPECAST_TTS_MODEL=ssfm-v31
TYPECAST_VOICE_ID=
# Explicit temporary alternative: AI_TTS_PROVIDER=openai (no automatic fallback).
# gpt-4o-mini-tts is scheduled to shut down on 2027-01-06.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
