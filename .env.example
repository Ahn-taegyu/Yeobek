# Copy to .env.local. Use a disposable local Supabase project first.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only trusted job worker; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000

# Server only. Add AI values to the existing .env.local without replacing Supabase settings.
# mock is only accepted with NODE_ENV=development or test; never deploy it.
AI_PROVIDER_MODE=live
AI_ROUTE_DRAFT=liner:openai/gpt-6.1-sol
AI_ROUTE_ORGANIZE=liner:openai/gpt-6.1-sol
AI_ROUTE_JUDGE=liner:google/gemini-3.8-flash
AI_ROUTE_QA=liner:openai/gpt-6-luna
AI_ROUTE_STT=liner:openai/whisper-1
# Set AI_ROUTE_TTS=liner:<model-id> and LINER_TTS_VOICE from your account's
# GET /v1/models catalog. Select an audio/speech model that supports MP3.
AI_ROUTE_TTS=
LINER_TTS_MODEL=
LINER_TTS_VOICE=
LINER_API_KEY=

# Comparison options (set the corresponding AI_ROUTE_* explicitly):
# openai:gpt-6-luna (text), openai:gpt-transcribe (STT), exaone:k-exaone_v2.5 (text),
# typecast:ssfm-v31 (TTS), openai:gpt-4o-mini-tts (temporary TTS).
# Judge and draft must always use different upstream model families.
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral
EXAONE_API_KEY=
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=

# Feature flags accept only true or false. Omit to use defaults; never leave empty.
FEATURE_GAPS=false
FEATURE_FOLLOW_UP_QUESTIONS=true
FEATURE_OPS_AGGREGATION=false
# Approved text can publish without pre-generated audio; visitor TTS is separate.
FEATURE_VOICE_REQUIRED=false
# Enable only after Auth confirmations, 8-character minimum, 6-digit code template and SMTP are configured.
FEATURE_SIGNUP=false
# W11 private generation/review; enable after database and client contracts are ready.
FEATURE_EXPECTED_QA=false
FEATURE_EXHIBITION_QA=false
FEATURE_EXHIBITION_SCOPE_CHAT=false
FEATURE_PREVIEW_CHAT=false
FEATURE_QA_REWRITE=false
FEATURE_MATERIAL_EXTRACTION=false
# Scanned PDFs/reference images only; text PDFs are extracted locally.
AI_ROUTE_MATERIAL=liner:google/gemini-3.8-flash

# W8 operational text uses Liner; mock mode is inherited from AI_PROVIDER_MODE.
# Omit AI_ROUTE_AUTOMATION to use the shared Liner draft model default.
# AI_ROUTE_AUTOMATION=liner:MODEL_ID_FROM_YOUR_CATALOG
STIBEE_API_KEY=
STIBEE_TRANSACTIONAL_URL=
STIBEE_MARKETING_URL=
STIBEE_PARAGRAPH_FIELD=yeobek_paragraph

# Channel AppStore server credentials. Token cache is encrypted in the DB.
# TOKEN_KEY is exactly 64 hexadecimal characters (32 random bytes), never public.
# Keep the key stable across restarts/workers; replacing it requires cache recovery.
# Signing key authenticates incoming functions; APP_SECRET issues outgoing tokens.
CHANNEL_TALK_APP_ID=
CHANNEL_TALK_CHANNEL_ID=
CHANNEL_TALK_APP_SECRET=
CHANNEL_TALK_TOKEN_KEY=
CHANNEL_TALK_SIGNING_KEY=
# Legacy customer-message webhook token from Channel Settings > Webhook.
# Different from the AppStore signing key; redact ?token= in proxy access logs.
CHANNEL_TALK_WEBHOOK_TOKEN=

# Server-only Bearer credential (at least 32 characters) for purge and automation cron.
# Configure purge hourly and notification processing at the chosen delivery interval.
# Never put this value in a browser or URL.
CRON_SECRET=

# Required in production for HMAC IP budgets. Set a server-only random secret (32+ characters).
# Vercel trusted x-forwarded-for is supported; other hosts share a conservative budget until verified.
VISITOR_IP_HASH_SECRET=

# Local demo only: run a development mock server with FEATURE_VOICE_REQUIRED=false and FEATURE_EXPECTED_QA=true.
# Generated login details go to ignored .env.demo.local (DEMO_EMAIL/DEMO_PASSWORD/DEMO_EXHIBITION_ID).
# DEMO_APP_ORIGIN=http://localhost:3001
# DEMO_ENV_FILE=.env.demo.local
