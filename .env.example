# Copy to .env.local. Use a disposable local Supabase project first.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only trusted job worker; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000

# Server only. Add AI values to the existing .env.local without replacing Supabase settings.
# mock is only accepted with NODE_ENV=development or test; never deploy it.
AI_PROVIDER_MODE=live
AI_ROUTE_DRAFT=liner:openai/gpt-6.1-sol
AI_ROUTE_ORGANIZE=liner:openai/gpt-6.1-sol
AI_ROUTE_JUDGE=liner:google/gemini-3.8-flash
AI_ROUTE_QA=liner:openai/gpt-6-luna
AI_ROUTE_STT=liner:openai/whisper-1
# Set AI_ROUTE_TTS=liner:<model-id> and LINER_TTS_VOICE from your account's
# GET /v1/models catalog. Select an audio/speech model that supports MP3.
AI_ROUTE_TTS=
LINER_TTS_MODEL=
LINER_TTS_VOICE=
LINER_API_KEY=

# Comparison options (set the corresponding AI_ROUTE_* explicitly):
# openai:gpt-6-luna (text), openai:gpt-transcribe (STT), exaone:k-exaone_v2.5 (text),
# typecast:ssfm-v31 (TTS), openai:gpt-4o-mini-tts (temporary TTS).
# Judge and draft must always use different upstream model families.
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral
EXAONE_API_KEY=
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=

# Feature flags accept only true or false. Omit to use defaults; never leave empty.
FEATURE_GAPS=true
FEATURE_FOLLOW_UP_QUESTIONS=true
FEATURE_OPS_AGGREGATION=true
FEATURE_VOICE_REQUIRED=true

# Server-only Bearer credential (at least 32 characters) for POST /api/cron/purge.
# Configure an hourly external scheduler. Never put this value in a browser or URL.
CRON_SECRET=
