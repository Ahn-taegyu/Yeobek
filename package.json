{
  "name": "yeobek",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "ai:check": "node scripts/ai-check.mjs",
    "ai:bundle": "node scripts/ai-plugin.mjs",
    "ai:bundle:check": "node scripts/ai-plugin.mjs --check",
    "knowledge:sections": "node scripts/knowledge-sections.mjs",
    "knowledge:sections:check": "node scripts/knowledge-sections.mjs --check",
    "pretest": "npm run ai:bundle:check && npm run knowledge:sections:check",
    "prebuild": "npm run ai:bundle:check",
    "preai:eval": "npm run ai:bundle:check",
    "preai:smoke": "npm run ai:bundle:check",
    "ai:eval": "vitest run tests/unit/ai-harness.test.ts tests/unit/ai-chat-intent.test.ts tests/unit/ai-narration-boundaries.test.ts tests/unit/ai-deadline-outcome.test.ts tests/unit/ai-playbook.test.ts tests/unit/ai-providers.test.ts tests/unit/ai-plugin.test.ts tests/unit/ai-narration.test.ts tests/unit/ai-comparison.test.ts",
    "preai:compare": "npm run ai:bundle:check",
    "ai:compare": "node scripts/ai-compare.mjs",
    "ai:compare:bivia": "node scripts/bivia-compare.mjs",
    "ai:review": "node scripts/ai-review.mjs",
    "ai:smoke": "node scripts/ai-smoke.mjs",
    "db:start": "node scripts/start-local.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --network-id yeobek-local",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:jobs": "node --test tests/integration/mock/jobs.test.mjs",
    "test:audio": "node --test tests/integration/mock/audio.test.mjs",
    "test:publication": "node --test tests/integration/mock/publication.test.mjs",
    "test:visitor": "node --test tests/integration/mock/visitor.test.mjs",
    "test:automation": "node --test tests/integration/mock/automation.test.mjs",
    "test:support": "node --test tests/integration/mock/support.test.mjs",
    "test:proposals": "node --test tests/integration/mock/proposals.test.mjs",
    "test:qa": "node --test tests/integration/mock/qa.test.mjs",
    "db:env": "node scripts/local-env.mjs",
    "db:artist": "node scripts/local-artist.mjs",
    "db:operator": "node scripts/local-operator.mjs",
    "db:types": "node scripts/database-types.mjs",
    "db:seed:demo": "node scripts/demo-seed.mjs",
    "test:demo:guards": "node --test tests/scripts/demo-seed.test.mjs",
    "test:demo": "node --test tests/integration/mock/demo-seed.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.32",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module"
}
